; Engine configuration file.
; It's best edited using the editor UI and not directly,
; since the parameters that go here are not all obvious.
;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="RAORA'S BASEMENT"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.6", "Forward Plus")

[autoload]

SpikeConfig="*res://autoload/spike_config.gd"
SpikeSave="*res://autoload/spike_save.gd"
SpikeKeys="*res://autoload/spike_keys.gd"
SpikeAudio="*res://autoload/spike_audio.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"

[input_devices]

; 平板/手機沒有實體鍵盤：開這個之後觸控拖曳/點擊會自動轉成滑鼠事件，
; well_world.gd 的鞭子瞄準（拖曳定方向）與發射（點一下＝滑鼠左鍵）完全不用改程式碼。
pointing/emulate_mouse_from_touch=true

[importer_defaults]

texture={
"mipmaps/generate": true
}

[rendering]

textures/canvas_textures/default_texture_filter=2
anti_aliasing/quality/msaa_2d=1
renderer/rendering_method.web="gl_compatibility"
